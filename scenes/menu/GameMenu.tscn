[gd_scene load_steps=3 format=3 uid="uid://b3m1ua2drmajh"]

[sub_resource type="GDScript" id="GDScript_e06li"]
script/source = "extends Control

# Sửa thành đường dẫn trực tiếp từ Node MainMenu xuống nút con
@onready var restart_btn = $RestartBtn
@onready var home_btn = $HomeBtn

func _ready() -> void:
	restart_btn.pressed.connect(_on_restart_btn_pressed)
	home_btn.pressed.connect(_on_home_btn_pressed)

func _on_restart_btn_pressed() -> void:
	get_tree().paused = false
	get_tree().reload_current_scene()

func _on_home_btn_pressed() -> void:
	get_tree().paused = false
	get_tree().change_scene_to_file(\"res://scenes/menu/MainMenu.tscn\")
"

[sub_resource type="GDScript" id="GDScript_nbvmo"]
script/source = "extends Button

@export var main_menu: Control

func _ready() -> void:
	pressed.connect(_on_menu_button_pressed)

func _on_menu_button_pressed() -> void:
	if main_menu:
		main_menu.visible = !main_menu.visible
		
		get_tree().paused = main_menu.visible
	else:
		print(\"Lỗi: Chưa gán Node Menu vào Inspector!\")
"

