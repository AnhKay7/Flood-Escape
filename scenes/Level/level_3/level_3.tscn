[sub_resource type="GDScript" id="GDScript_mgslf"]
script/source = "extends Area2D

@onready var hidden_bridge: TileMapLayer = $\"../HiddenBridge\"
@onready var label: Label = $Label
@onready var before: Sprite2D = $Before
@onready var after: Sprite2D = $After
@onready var moving_platform: AnimatableBody2D = $\"../../Platform/Moving Platform\"
@onready var moving_platform_2: AnimatableBody2D = $\"../../Platform/Moving Platform2\"
@onready var audio_stream_player_2d: AudioStreamPlayer2D = $AudioStreamPlayer2D

func _ready() -> void:
	before.visible = true
	after.visible = false
	
	# === TẮT VẬT LÝ CỦA CẦU TỪ LÚC MỚI VÀO GAME ===
	hidden_bridge.collision_enabled = false
	hidden_bridge.visible = false
	hidden_bridge.modulate.a = 0.0
# Biến cờ hiệu để biết cáo đang đứng đúng vị trí hay không
var can_interact: bool = false 

# --- TÍN HIỆU RA VÀO VÙNG ---
func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Player\":
		can_interact = true
		label.visible = true
		# Tùy chọn cho Demo: In ra màn hình để biết đã đứng đúng chỗ
		print(\"Ấn F (hoặc X trên tay cầm) để kích hoạt!\") 

func _on_body_exited(body: Node2D) -> void:
	if body.name == \"Player\":
		label.visible = false
		can_interact = false

# --- KIỂM TRA PHÍM BẤM ---
func _unhandled_input(event: InputEvent) -> void:
	# Nếu ấn nút \"interact\" VÀ đang đứng trên bục
	if event.is_action_pressed(\"interact\") and can_interact:
		activate_bridge()

# --- LOGIC MỞ CẦU ---
func update_sprite() -> void:
	before.visible = false
	after.visible = true
	moving_platform.free()
	moving_platform_2.free()
	
func activate_bridge() -> void:
	#0. Anh cua nut:
	update_sprite()
	# 1. Bật vật lý cho cầu
	hidden_bridge.collision_enabled = true
	
	# 2. Hiện cầu từ từ (Fade-in)
	hidden_bridge.visible = true
	hidden_bridge.modulate.a = 0.0 
	var tween = create_tween()
	tween.tween_property(hidden_bridge, \"modulate:a\", 1.0, 0.5)
	
	# 3. Chặn không cho bấm lại lần 2
	can_interact = false
	set_deferred(\"monitoring\", false) # Tắt vùng quét Area2D
	audio_stream_player_2d.play()
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_2mqoe"]
size = Vector2(35, 14)

[sub_resource type="GDScript" id="GDScript_d12gi"]
script/source = "extends Area2D

@onready var label: Label = $Label
@onready var before: Sprite2D = $Before
@onready var after: Sprite2D = $After
@onready var door: TileMapLayer = $\"../Door\"
@onready var audio_stream_player_2d: AudioStreamPlayer2D = $AudioStreamPlayer2D

signal cutscene_triggered

func _ready() -> void:
	before.visible = true
	after.visible = false

var can_interact: bool = false 


func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Player\":
		can_interact = true
		label.visible = true
		print(\"Ấn F (hoặc X trên tay cầm) để kích hoạt!\") 

func _on_body_exited(body: Node2D) -> void:
	if body.name == \"Player\":
		label.visible = false
		can_interact = false
		
func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"interact\") and can_interact:
		activate()

func update_sprite() -> void:
	before.visible = false
	after.visible = true
	
func activate() -> void:

	update_sprite()
	audio_stream_player_2d.play()
	
	cutscene_triggered.emit()
	
	var tween = create_tween()
	tween.tween_property(door, \"position:y\", door.position.y - 128, 1.0)
	door.collision_enabled = false

	can_interact = false
	set_deferred(\"monitoring\", false) 
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_jbbhb"]
size = Vector2(136, 133)

[sub_resource type="GDScript" id="GDScript_42xeq"]
script/source = "extends Area2D

@onready var player: Player = $\"../../Player\"

const VERTICAL_BASE_SPEED = 50.0   
const VERTICAL_CATCH_UP_SPEED = 100.0

const HORIZONTAL_BASE_SPEED = 40.0    
const HORIZONTAL_CATCH_UP_SPEED = 60.0 

const SAFE_DISTANCE = 170.0 

var rise_speed: float = 0.0
var is_active: bool = false
var is_horizontal_zone: bool = false 

func _physics_process(delta: float) -> void:
	if not is_active:
		return
		
	var target_base_speed = HORIZONTAL_BASE_SPEED if is_horizontal_zone else VERTICAL_BASE_SPEED
	var target_catch_up_speed = HORIZONTAL_CATCH_UP_SPEED if is_horizontal_zone else VERTICAL_CATCH_UP_SPEED
	
	var distance_y = position.y - player.position.y
	
	if distance_y > SAFE_DISTANCE * 2:
		position.y = player.position.y + SAFE_DISTANCE * 1.2
		rise_speed = target_catch_up_speed
	elif distance_y > SAFE_DISTANCE:
		rise_speed = move_toward(rise_speed, target_catch_up_speed, 180.0 * delta)
	else:
		rise_speed = move_toward(rise_speed, target_base_speed, 180.0 * delta)
		
	position.y -= rise_speed * delta


func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Player\":
		var state_machine = body.get_node_or_null(\"StateMachine\")
		
		# 3. Nếu tìm thấy, gọi thẳng hàm chuyển trạng thái của bạn
		if state_machine:
			# LƯU Ý: Chữ \"DeathState\" phải gõ chính xác 100% với tên Node con 
			# nằm trong StateMachine ở Scene của Player.
			state_machine._transition_to_next_state(\"Death\")


func _on_area_entered(area: Area2D) -> void:
	pass 
"

