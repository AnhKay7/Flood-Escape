[sub_resource type="GDScript" id="GDScript_5csmw"]
script/source = "extends Area2D

@onready var acid_water: Area2D = $\"../Acid_Water\"

func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Player\":
		# Đánh thức dòng nước! Ép nó dâng lên với tốc độ 60 pixel/s
		acid_water.is_active = true
		print(\"YES\")
		# Xóa cái Trigger này đi để nó không kích hoạt lại lần nữa
		queue_free()
"

