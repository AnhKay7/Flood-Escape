[sub_resource type="GDScript" id="GDScript_mgslf"]
script/source = "extends Area2D

@onready var hidden_bridge: TileMapLayer = $\"../HiddenBridge\"
@onready var label: Label = $Label
@onready var before: Sprite2D = $Before
@onready var after: Sprite2D = $After
@onready var moving_platform: AnimatableBody2D = $\"../../Platform/Moving Platform\"
@onready var moving_platform_2: AnimatableBody2D = $\"../../Platform/Moving Platform2\"

func _ready() -> void:
	before.visible = true
	after.visible = false
	
	# === TẮT VẬT LÝ CỦA CẦU TỪ LÚC MỚI VÀO GAME ===
	hidden_bridge.collision_enabled = false
	hidden_bridge.visible = false
	hidden_bridge.modulate.a = 0.0
# Biến cờ hiệu để biết cáo đang đứng đúng vị trí hay không
var can_interact: bool = false 

# --- TÍN HIỆU RA VÀO VÙNG ---
func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Player\":
		can_interact = true
		label.visible = true
		# Tùy chọn cho Demo: In ra màn hình để biết đã đứng đúng chỗ
		print(\"Ấn F (hoặc X trên tay cầm) để kích hoạt!\") 

func _on_body_exited(body: Node2D) -> void:
	if body.name == \"Player\":
		label.visible = false
		can_interact = false

# --- KIỂM TRA PHÍM BẤM ---
func _unhandled_input(event: InputEvent) -> void:
	# Nếu ấn nút \"interact\" VÀ đang đứng trên bục
	if event.is_action_pressed(\"interact\") and can_interact:
		activate_bridge()

# --- LOGIC MỞ CẦU ---
func update_sprite() -> void:
	before.visible = false
	after.visible = true
	moving_platform.free()
	moving_platform_2.free()
	
func activate_bridge() -> void:
	#0. Anh cua nut:
	update_sprite()
	# 1. Bật vật lý cho cầu
	hidden_bridge.collision_enabled = true
	
	# 2. Hiện cầu từ từ (Fade-in)
	hidden_bridge.visible = true
	hidden_bridge.modulate.a = 0.0 
	var tween = create_tween()
	tween.tween_property(hidden_bridge, \"modulate:a\", 1.0, 0.5)
	
	# 3. Chặn không cho bấm lại lần 2
	can_interact = false
	set_deferred(\"monitoring\", false) # Tắt vùng quét Area2D
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_2mqoe"]
size = Vector2(35, 14)

[sub_resource type="GDScript" id="GDScript_d12gi"]
script/source = "extends Area2D

@onready var label: Label = $Label
@onready var before: Sprite2D = $Before
@onready var after: Sprite2D = $After
@onready var door: TileMapLayer = $\"../Door\"


func _ready() -> void:
	before.visible = true
	after.visible = false

var can_interact: bool = false 


func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Player\":
		can_interact = true
		label.visible = true
		print(\"Ấn F (hoặc X trên tay cầm) để kích hoạt!\") 

func _on_body_exited(body: Node2D) -> void:
	if body.name == \"Player\":
		label.visible = false
		can_interact = false
		
func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"interact\") and can_interact:
		activate()

func update_sprite() -> void:
	before.visible = false
	after.visible = true
	
func activate() -> void:

	update_sprite()

	var tween = create_tween()
	tween.tween_property(door, \"position:y\", door.position.y - 128, 1.0)
	door.collision_enabled = false

	can_interact = false
	set_deferred(\"monitoring\", false) 
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_jbbhb"]
